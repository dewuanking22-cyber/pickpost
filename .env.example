# Copy to .env (or set these in your host's dashboard). All optional.
PORT=3000
NODE_ENV=production
APP_NAME=PickPost
TAGLINE=Share trading ideas and sports picks. Build a public track record.
ACCENT_COLOR=#4f46e5
# Where the SQLite database lives. On Render/Railway point this at a persistent disk/volume (e.g. /data)
DATA_DIR=./data
# Optional free key from https://finnhub.io for stock quotes (otherwise Yahoo's unofficial endpoint is used)
FINNHUB_API_KEY=
# Turn all live market/sports data off (no outbound calls)
# MARKET_DATA=off
# Always-admin usernames (comma separated). The first account to sign up is admin anyway.
ADMIN_USERNAMES=
# Graded votes needed to appear on the vote leaderboards (default 3)
# VOTE_LEADERBOARD_MIN=3
