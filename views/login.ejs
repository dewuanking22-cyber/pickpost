<%- include('partials/header') %>
<div class="narrow">
<h1>Log in</h1>
<% if (error) { %><div class="alert"><%= error %></div><% } %>
<form method="post" action="/login" class="card form">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
  <label>Username<input name="username" value="<%= form.username || '' %>" autocomplete="username" required autofocus></label>
  <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
  <button class="btn">Log in</button>
  <p class="muted small">No account? <a href="/signup">Sign up</a></p>
</form>
</div>
<%- include('partials/footer') %>
